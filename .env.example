# Postgres
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/contamination_cc

# MQTT broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# leave blank for local Mosquitto with no auth
MQTT_USERNAME=
MQTT_PASSWORD=

# Windows
RETENTION_HOURS=12

# Baselining (shortened for demo; real system uses 24-48h)
BASELINING_PERIOD_SECONDS=90

# Simulation control proxy (demo-only — see README §Simulation Control Proxy)
NODE_ORCHESTRATOR_URL=http://localhost:8100

# OTA model file serving — this service's own externally-reachable base URL (nodes download
# pushed models from PUBLIC_URL/models/file/{contaminant_id}/{version}) and the local directory
# pushed model files are copied into
PUBLIC_URL=http://localhost:8000
MODEL_FILES_DIR=./model_files

# Logging
LOG_LEVEL=INFO
